{
  "version": "1.0",
  "skill": "eval-power",
  "description": "Eval suite for eval-power: noise floor, reps, interval, claim verdicts, envelope.",
  "model": "claude-sonnet-4-20250514",
  "cases": [
    {
      "id": "chain-review-bot",
      "description": "Shared fixture agent review-bot; upstream from gold: gold-set, metric-signature",
      "fixture": "../sia-chain/agents/review-bot.json",
      "assertions": [
        {
          "type": "sia_envelope_valid",
          "expected": true
        },
        {
          "type": "sia_out_fields",
          "expected": [
            "reps",
            "interval",
            "interpretation",
            "claimVerdicts"
          ]
        },
        {
          "type": "sia_recommendations",
          "expected": true
        },
        {
          "type": "sia_gold",
          "expected": {
            "skill": "eval-power",
            "agent": "review-bot"
          }
        },
        {
          "type": "judge",
          "expected": {
            "rubric": "tests/sia-chain/buyer-rubric.md"
          }
        }
      ],
      "upstream": [
        "gold-set",
        "metric-signature"
      ]
    },
