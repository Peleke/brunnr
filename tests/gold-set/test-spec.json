{
  "version": "1.0",
  "skill": "gold-set",
  "description": "Eval suite for gold-set: example schema, sources, labeling, grouped split, envelope.",
  "model": "claude-sonnet-4-20250514",
  "cases": [
    {
      "id": "chain-review-bot",
      "description": "Shared fixture agent review-bot; upstream from gold: metric-signature",
      "fixture": "../sia-chain/agents/review-bot.json",
      "assertions": [
        {
          "type": "sia_envelope_valid",
          "expected": {
            "skill": "gold-set",
            "deploymentType": "coding-harness"
          }
        },
        {
          "type": "sia_out_fields",
          "expected": [
            "exampleSchema",
            "sources",
            "labelingPlan",
            "split",
            "leakageChecks"
          ]
        },
        {
          "type": "sia_recommendations",
          "expected": true
        },
        {
          "type": "sia_gold",
          "expected": {
            "skill": "gold-set",
            "agent": "review-bot"
          }
        },
        {
          "type": "judge",
          "expected": {
            "rubric": "tests/sia-chain/buyer-rubric.md"
          }
        }
      ],
      "upstream": [
        "metric-signature"
      ]
    },
