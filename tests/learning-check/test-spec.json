        },
        {
          "type": "judge",
          "expected": {
            "rubric": "tests/sia-chain/buyer-rubric.md"
          }
        }
      ]
    },
    {
      "id": "chain-intent-classifier",
      "description": "Shared fixture agent intent-classifier",
      "fixture": "../sia-chain/agents/intent-classifier.json",
      "assertions": [
        {
          "type": "sia_envelope_valid",
          "expected": {
            "skill": "learning-check",
            "deploymentType": "prompt-program"
