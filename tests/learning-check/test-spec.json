{
  "version": "1.0",
  "skill": "learning-check",
  "description": "Eval suite for learning-check: per-loop verdicts, outcome, envelope.",
  "model": "claude-sonnet-4-20250514",
  "cases": [
    {
      "id": "memory-only-bot",
      "description": "Support bot with unweighted vector memory and no outcome capture: Q1 no, Q2 partial, Q3 no",
      "fixture": "fixtures/memory-only-bot.json",
      "assertions": [
        {
          "type": "has_table",
          "expected": true
        },
        {
          "type": "contains",
          "expected": "Learning Check"
        },
        {
          "type": "contains",
          "expected": "First fix"
        },
        {
          "type": "contains",
          "expected": "Memory vs learning"
        }
      ]
    },
    {
      "id": "eval-backed-classifier",
      "description": "Classifier with labeled eval set, nightly scoring, demo rebuild: mostly yes",
      "fixture": "fixtures/eval-backed-classifier.json",
      "assertions": [
        {
          "type": "has_table",
          "expected": true
        },
        {
          "type": "contains",
          "expected": "yes"
        },
        {
          "type": "contains",
          "expected": "held-out"
        }
      ]
    },
    {
      "id": "chain-review-bot",
      "description": "Shared fixture agent review-bot",
      "fixture": "../sia-chain/agents/review-bot.json",
      "assertions": [
        {
          "type": "sia_envelope_valid",
          "expected": {
            "skill": "learning-check",
            "deploymentType": "coding-harness"
          }
        },
        {
          "type": "sia_out_fields",
          "expected": [
            "verdicts.signal",
            "verdicts.update",
            "verdicts.convergence",
            "loops",
            "outcome",
            "firstFix"
          ]
        },
        {
          "type": "sia_recommendations",
          "expected": true
        },
        {
          "type": "sia_gold",
          "expected": {
            "skill": "learning-check",
            "agent": "review-bot"
          }
        },
        {
          "type": "judge",
          "expected": {
            "rubric": "tests/sia-chain/buyer-rubric.md"
          }
        }
      ]
    },
    {
      "id": "chain-home-assistant",
      "description": "Shared fixture agent home-assistant",
      "fixture": "../sia-chain/agents/home-assistant.json",
      "assertions": [
        {
          "type": "sia_envelope_valid",
          "expected": {
            "skill": "learning-check",
            "deploymentType": "gateway-agent"
          }
        },
        {
          "type": "sia_out_fields",
          "expected": [
            "verdicts.signal",
            "verdicts.update",
            "verdicts.convergence",
            "loops",
            "outcome",
            "firstFix"
          ]
        },
        {
          "type": "sia_recommendations",
          "expected": true
        },
        {
          "type": "sia_gold",
          "expected": {
            "skill": "learning-check",
            "agent": "home-assistant"
          }
        },
        {
          "type": "judge",
          "expected": {
            "rubric": "tests/sia-chain/buyer-rubric.md"
          }
        }
      ]
    },
    {
      "id": "chain-support-triage",
      "description": "Shared fixture agent support-triage",
