          }
        }
      ]
    },
    {
      "id": "chain-sales-gpt",
      "description": "Shared fixture agent sales-gpt",
      "fixture": "../sia-chain/agents/sales-gpt.json",
      "assertions": [
        {
          "type": "sia_envelope_valid",
          "expected": {
            "skill": "learning-check",
            "deploymentType": "hosted-nocode"
          }
        },
        {
          "type": "sia_out_fields",
          "expected": [
            "verdicts.signal",
            "verdicts.update",
            "verdicts.convergence",
            "loops",
            "outcome",
            "firstFix"
          ]
        },
        {
          "type": "sia_recommendations",
          "expected": true
        },
        {
          "type": "sia_gold",
          "expected": {
            "skill": "learning-check",
            "agent": "sales-gpt"
          }
        },
        {
          "type": "judge",
          "expected": {
