{
  "version": "1.0",
  "skill": "metric-signature",
  "description": "Eval suite for metric-signature: metric tiers, signatures, baseline, envelope.",
  "model": "claude-sonnet-4-20250514",
  "cases": [
    {
      "id": "chain-review-bot",
      "description": "Shared fixture agent review-bot; upstream from gold: signal-card",
      "fixture": "../sia-chain/agents/review-bot.json",
      "assertions": [
        {
          "type": "sia_envelope_valid",
          "expected": {
            "skill": "metric-signature",
            "deploymentType": "coding-harness"
          }
        },
        {
          "type": "sia_out_fields",
          "expected": [
            "metrics",
            "metrics[].outputField",
            "metrics[].tier",
            "metrics[].labelsNeeded",
            "metrics[].signature",
            "baseline",
            "fieldsUnscored"
          ]
        },
        {
          "type": "sia_recommendations",
          "expected": true
        },
        {
          "type": "sia_gold",
          "expected": {
            "skill": "metric-signature",
            "agent": "review-bot"
          }
        },
        {
          "type": "judge",
          "expected": {
            "rubric": "tests/sia-chain/buyer-rubric.md"
          }
        }
      ],
      "upstream": [
        "signal-card"
      ]
    },
