{
  "version": "1.0",
  "skill": "signal-card",
  "description": "Eval suite for signal-card: one-line signal, slots, envelope.",
  "model": "claude-sonnet-4-20250514",
  "cases": [
    {
      "id": "prompt-editing-operator",
      "description": "Operator edits prompt by hand: card must say 'you are the loop' and propose a signal",
      "fixture": "fixtures/prompt-editing-operator.json",
      "assertions": [
        {
          "type": "has_table",
          "expected": true
        },
        {
          "type": "contains",
          "expected": "gets better when"
        },
        {
          "type": "contains",
          "expected": "you are the loop"
        },
        {
          "type": "contains",
          "expected": "Slots"
        }
      ]
    },
    {
      "id": "chain-review-bot",
      "description": "Shared fixture agent review-bot; upstream from gold: learning-check",
      "fixture": "../sia-chain/agents/review-bot.json",
      "assertions": [
        {
          "type": "sia_envelope_valid",
          "expected": {
            "skill": "signal-card",
            "deploymentType": "coding-harness"
          }
        },
        {
          "type": "sia_out_fields",
          "expected": [
            "candidates",
            "chosenSignal",
            "oneLine",
            "slots.signal",
            "slots.search",
            "slots.artifact"
          ]
        },
        {
          "type": "sia_recommendations",
          "expected": true
        },
        {
          "type": "sia_gold",
          "expected": {
            "skill": "signal-card",
            "agent": "review-bot"
          }
        },
        {
          "type": "judge",
          "expected": {
            "rubric": "tests/sia-chain/buyer-rubric.md"
          }
        }
      ],
      "upstream": [
        "learning-check"
      ]
    },
    {
      "id": "chain-home-assistant",
      "description": "Shared fixture agent home-assistant; upstream from gold: learning-check",
      "fixture": "../sia-chain/agents/home-assistant.json",
      "assertions": [
        {
          "type": "sia_envelope_valid",
