            "skill": "signal-card",
            "deploymentType": "gateway-agent"
          }
        },
        {
          "type": "sia_out_fields",
          "expected": [
            "candidates",
            "chosenSignal",
            "oneLine",
            "slots.signal",
            "slots.search",
            "slots.artifact"
          ]
        },
        {
          "type": "sia_recommendations",
